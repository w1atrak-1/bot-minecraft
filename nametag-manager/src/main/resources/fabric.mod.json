  "license": "MIT",
  "icon": "assets/nametagmanager/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "com.example.nametagmanager.NametagManager"
    ]
  },
  "depends": {
    "fabricloader": ">=0.14.0",
